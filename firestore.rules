rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin'
      );
    }

    function isValidUserRecord(data) {
      return data.email is string &&
        data.name is string &&
        data.role in ['student', 'admin'] &&
        data.createdAt is timestamp &&
        data.createdAt <= request.time;
    }

    function isValidStudentProfile(data) {
      return data.userId is string &&
        data.fullName is string &&
        data.email is string &&
        data.mobileNumber is string &&
        data.academicYear in ['First Year', 'Second Year', 'Third Year', 'Fourth Year'] &&
        data.branch is string &&
        data.roomAllocationStatus in ['unallocated', 'allocated'] &&
        data.block is string &&
        data.roomNumber is string &&
        data.photoUrl is string &&
        data.updatedAt is timestamp &&
        data.updatedAt <= request.time;
    }

    function isValidRoom(data) {
      return data.block in ['Hemavati Block', 'Kaveri Block', 'MCA Block'] &&
        data.roomNumber is string &&
        data.capacity == 2 &&
        data.occupiedBeds is int &&
        data.occupiedBeds >= 0 &&
        data.occupiedBeds <= 2 &&
        data.studentIds is list &&
        data.studentIds.size() <= 2 &&
        data.isAvailable is bool &&
        data.updatedAt is timestamp &&
        data.updatedAt <= request.time;
    }

    function isValidRoomAllocation(data) {
      return data.studentId is string &&
        data.studentName is string &&
        data.academicYear is string &&
        data.branch is string &&
        data.block in ['Hemavati Block', 'Kaveri Block', 'MCA Block'] &&
        data.roomNumber is string &&
        data.allocatedAt is timestamp &&
        data.allocatedAt <= request.time;
    }

    function isValidBill(data) {
      return data.billRef is string &&
        data.studentId is string &&
        data.studentName is string &&
        data.billType in ['Room Fee', 'Mess Fee'] &&
        data.billingPeriod is string &&
        data.totalAmount is number &&
        data.totalAmount >= 0 &&
        data.amountPaid is number &&
        data.amountPaid >= 0 &&
        data.balanceAmount is number &&
        data.dueDate is string &&
        data.paymentStatus in ['Pending', 'Partially Paid', 'Paid', 'Overdue'] &&
        data.remarks is string &&
        data.createdAt is timestamp &&
        data.createdAt <= request.time &&
        data.updatedAt is timestamp &&
        data.updatedAt <= request.time;
    }

    function isValidPayment(data) {
      return data.receiptRef is string &&
        data.billId is string &&
        data.studentId is string &&
        data.studentName is string &&
        data.billType is string &&
        data.amount is number &&
        data.amount > 0 &&
        data.paymentDate is string &&
        data.paymentMethod in ['Cash', 'Bank Transfer', 'UPI', 'Online'] &&
        data.transactionRef is string &&
        data.remarks is string &&
        data.status in ['Verified', 'Pending', 'Failed'] &&
        data.createdAt is timestamp &&
        data.createdAt <= request.time;
    }

    function isValidComplaint(data) {
      return data.complaintRef is string &&
        data.studentId is string &&
        data.studentName is string &&
        data.academicYear is string &&
        data.branch is string &&
        data.block is string &&
        data.roomNumber is string &&
        data.mobileNumber is string &&
        data.category in ['Room maintenance', 'Electricity', 'Water supply', 'Bathroom', 'Cleaning', 'Mess food', 'Furniture', 'Other'] &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 100 &&
        data.description is string &&
        data.description.size() > 0 &&
        data.description.size() <= 1000 &&
        data.photoUrl is string &&
        data.status in ['Submitted', 'In Progress', 'Resolved', 'Rejected'] &&
        data.adminResponse is string &&
        data.submittedAt is timestamp &&
        data.submittedAt <= request.time &&
        data.updatedAt is timestamp &&
        data.updatedAt <= request.time;
    }

    function isValidSmsReminder(data) {
      return data.studentId is string &&
        data.studentName is string &&
        data.mobileNumber is string &&
        data.billId is string &&
        data.billType is string &&
        data.amount is number &&
        data.dueDate is string &&
        data.message is string &&
        data.status in ['Sent', 'Failed', 'Pending', 'Delivered'] &&
        data.providerResponse is string &&
        data.sentAt is timestamp &&
        data.sentAt <= request.time;
    }

    function isValidNotification(data) {
      return data.recipientId is string &&
        data.title is string &&
        data.message is string &&
        data.type in ['BILL', 'COMPLAINT', 'ALLOCATION', 'GENERAL'] &&
        data.isRead is bool &&
        data.createdAt is timestamp &&
        data.createdAt <= request.time;
    }

    // User accounts
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId) && isValidUserRecord(request.resource.data);
      allow update: if (isUser(userId) && request.resource.data.role == resource.data.role && isValidUserRecord(request.resource.data)) || (isAdmin() && isValidUserRecord(request.resource.data));
      allow delete: if isAdmin();
    }

    // Student profiles
    match /studentProfiles/{userId} {
      allow read: if isUser(userId) || isAdmin() || (isAuthenticated() && resource.data.roomAllocationStatus == 'allocated');
      allow create: if (isUser(userId) || isAdmin()) && isValidStudentProfile(request.resource.data);
      allow update: if (isUser(userId) || isAdmin()) && isValidStudentProfile(request.resource.data);
      allow delete: if isAdmin();
    }

    // Rooms
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin() && isValidRoom(request.resource.data);
      allow update: if (isAdmin() || (isAuthenticated() && request.auth.uid in request.resource.data.studentIds)) && isValidRoom(request.resource.data);
    }

    // Room Allocations
    match /roomAllocations/{allocationId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.studentId == request.auth.uid || isAdmin()) && isValidRoomAllocation(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Bills
    match /bills/{billId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create, delete: if isAdmin() && isValidBill(request.resource.data);
      allow update: if (isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid)) && isValidBill(request.resource.data);
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.studentId == request.auth.uid || isAdmin()) && isValidPayment(request.resource.data);
      allow update, delete: if isAdmin() && isValidPayment(request.resource.data);
    }

    // Complaints
    match /complaints/{complaintId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid && isValidComplaint(request.resource.data);
      allow update: if (isAdmin() || (isUser(resource.data.studentId) && request.resource.data.status == resource.data.status)) && isValidComplaint(request.resource.data);
      allow delete: if isAdmin();
    }

    // SMS Reminders
    match /smsReminders/{reminderId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidSmsReminder(request.resource.data);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || resource.data.recipientId == 'all' || (resource.data.recipientId == 'admin' && isAdmin()));
      allow create: if isAuthenticated() && isValidNotification(request.resource.data);
      allow update: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin()) && isValidNotification(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
